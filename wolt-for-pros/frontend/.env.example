NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: Mapbox tiles instead of OpenStreetMap.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Demo mode runs the whole app against an in-browser mock (no backend needed).
# Unset: automatic, used when the API at NEXT_PUBLIC_API_URL is unreachable.
# true: always demo. false: never demo.
NEXT_PUBLIC_DEMO_MODE=
