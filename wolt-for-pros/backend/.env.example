# Local development uses SQLite. For PostgreSQL run `npm run db:use-postgres`
# and set e.g. DATABASE_URL="postgresql://user:pass@localhost:5432/wolt_for_pros"
DATABASE_URL="file:./dev.db"

PORT=4000
FRONTEND_URL="http://localhost:3000"

# Required in production. Any long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Share of the job price the platform takes from the tradesperson's wallet.
PLATFORM_FEE_RATE=0.15

# Stripe (test mode keys). Leave STRIPE_SECRET_KEY empty to run in mock mode:
# top-ups are then credited directly, without a payment.
STRIPE_SECRET_KEY=""
# From `stripe listen` (local) or the webhook endpoint settings (production).
STRIPE_WEBHOOK_SECRET=""

# Allow POST /api/wallet/deposit to credit a wallet without a payment.
# Always on in mock mode; never enable it in production.
ALLOW_DIRECT_DEPOSIT=false

# SMS login codes. Required in production (or set ALLOW_PHONE_ONLY_LOGIN=true).
# Without Twilio credentials, codes are printed to the server log.
OTP_REQUIRED=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Number of proxies in front of the API, for correct client IPs in rate limits.
TRUST_PROXY=0
