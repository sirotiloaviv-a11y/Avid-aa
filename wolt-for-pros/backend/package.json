{
  "name": "wolt-for-pros-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API, wallet engine, real-time tracking and anti-fraud for Wolt for Pros",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:use-postgres": "node scripts/set-db-provider.js postgresql",
    "db:use-sqlite": "node scripts/set-db-provider.js sqlite",
    "stripe:listen": "stripe listen --forward-to localhost:4000/api/webhooks/stripe",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "stripe": "^17.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
