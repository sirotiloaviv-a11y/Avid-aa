# ---------------------------------------------------------------------------
# Veyra Security Brain — environment template
#
# Copy to .env and fill in real values locally:
#
#     cp .env.example .env
#
# .env is gitignored. NEVER put a real secret in this file, and never commit
# a real secret anywhere in the repository. Every value below is a
# non-functional placeholder.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development

# --- Database --------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# The values below match docker-compose.yml, which reads POSTGRES_* from this
# same file. Change the password before using this anywhere but a local
# machine, and use a secret manager in production rather than a .env file.
DATABASE_URL=postgresql://veyra:CHANGE_ME_LOCAL_ONLY@localhost:5432/veyra_security_brain?schema=public

# Credentials for the local docker compose Postgres service. These must stay
# consistent with DATABASE_URL above.
POSTGRES_USER=veyra
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=veyra_security_brain
POSTGRES_PORT=5432

# --- Application -----------------------------------------------------------
# Absolute base URL the app is served from. Used for building absolute links
# and, later, for OAuth redirect validation.
APP_URL=http://localhost:3000
