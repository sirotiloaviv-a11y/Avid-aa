# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit the real .env — it holds your token.
# ---------------------------------------------------------------------------

# --- Telegram (required) ---------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your personal chat id — where alerts land.
# Find it: message your bot, then run
#   python -m security_alert_system.main --chat-id
TELEGRAM_ALERT_CHAT_ID=123456789

# Channels the BOT IS AN ADMIN OF. The Bot API cannot read channels you do not
# control — for those, use the RSS bridge (see README).
# TELEGRAM_CHANNELS=@my_alerts_channel,-1001234567890


# --- RSS sources -----------------------------------------------------------
# Comma- or newline-separated. Omit entirely to use the built-in Israeli
# news defaults in config.py.
# RSS_FEEDS=https://www.ynet.co.il/Integration/StoryRss1854.xml,https://rcs.mako.co.il/rss/news-military.xml

# Public Telegram channels you do NOT control, bridged to RSS:
# RSS_FEEDS=https://rsshub.app/telegram/channel/some_public_channel


# --- Keywords --------------------------------------------------------------
# Optional. Overrides the default Hebrew set in keywords.py entirely.
# Format: phrase[:SEVERITY]  (INFO | ELEVATED | HIGH | CRITICAL)
# Quote a phrase to require an exact match with no prefix/suffix tolerance.
# KEYWORDS=פיגוע:CRITICAL,"צבע אדום":CRITICAL,אירוע ביטחוני:CRITICAL,אזעקה:HIGH


# --- Timing / behaviour ----------------------------------------------------
RSS_POLL_SECONDS=60
TELEGRAM_POLL_SECONDS=25
HTTP_TIMEOUT_SECONDS=20
MAX_ITEMS_PER_FEED=25

# On a first run with no saved state, index existing items silently instead of
# alerting on everything already published. Strongly recommended.
PRIME_WITHOUT_ALERTING=true

# Persist across restarts by pointing this at a mounted volume.
STATE_PATH=./security_alert_system/state/seen.json
STATE_MAX_ENTRIES=5000

LOG_LEVEL=INFO


# --- AI assistant (see assistant.py) ---------------------------------------
# A Karen/EDITH-style assistant you can talk to in your private chat with the
# bot. It answers from live system state via tools — it does not guess.
ASSISTANT_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...

ASSISTANT_MODEL=claude-opus-5
# low | medium | high | xhigh | max — medium is a good balance for chat.
ASSISTANT_EFFORT=medium
ASSISTANT_NAME=קארן
ASSISTANT_OWNER_NAME=אביב
# Conversation turns kept in context (each turn = your message + its reply).
ASSISTANT_HISTORY_TURNS=12
# Add a line of context after alerts at this severity or above.
# Set to a level that never occurs (e.g. INFO is unused) to disable briefs.
ASSISTANT_BRIEF_ON_SEVERITY=CRITICAL


# --- Voice (see voice.py) --------------------------------------------------
# Talk to the assistant with headphones on. You hold the mic button in
# Telegram, speak Hebrew, and the reply comes back as a voice note that
# auto-plays. Requires ASSISTANT_ENABLED=true.
VOICE_ENABLED=false

# openai = hosted, fast, good Hebrew, needs a key.
# local  = whisper on your own machine, no key, no audio leaves the host,
#          slower, needs `pip install faster-whisper`.
VOICE_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# match = answer in the medium the question arrived in (recommended).
# Also: voice (always speak), text (never speak), both.
VOICE_REPLY_MODE=match

VOICE_TRANSCRIBE_MODEL=whisper-1
VOICE_SPEAK_MODEL=gpt-4o-mini-tts
VOICE_NAME=shimmer
# Local provider only: tiny | base | small | medium | large-v3
VOICE_WHISPER_MODEL=small


# --- Ingest (see ingest.py and bridges/README.md) ---------------------------
# One authenticated route anything outside the monitor can push into:
# WhatsApp bridges, scrapers for sites with no RSS, a camera agent at home.
# Everything pushed here runs the same keyword filter and becomes the same alert.
INGEST_ENABLED=false
# Must be set when enabled, and must differ from DASHBOARD_TOKEN — a read
# token should not also let someone inject alerts.
#   openssl rand -hex 32
# INGEST_TOKEN=

# --- Status dashboard (see dashboard.py) -----------------------------------
DASHBOARD_ENABLED=true

# 127.0.0.1 means "reachable only from inside the container" — view it with
# docker exec, an SSH tunnel, or your platform's port-forward.
# Binding to 0.0.0.0 WITHOUT a token is rejected at startup: it would publish
# your alert history to anyone who can reach the port.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# DASHBOARD_TOKEN=generate-a-long-random-string

# How many past alerts the dashboard keeps and shows.
ALERT_HISTORY_SIZE=100


# --- Cameras (placeholder — see cameras.py) --------------------------------
# Your cameras are on a LAN; this script runs in the cloud and CANNOT reach
# them directly. Read the docstring at the top of cameras.py first.
CAMERAS_ENABLED=false

# null       - default, does nothing (placeholder)
# ffmpeg     - direct RTSP grab; only works if the host can reach the camera
#              (i.e. you joined the container to a Tailscale/WireGuard mesh)
# push_inbox - an agent at home uploads JPEGs here; the cloud only reads them
CAMERA_CONNECTOR=null

# Attach snapshots to alerts at this severity or above.
CAMERA_SNAPSHOT_ON_SEVERITY=CRITICAL

# For CAMERA_CONNECTOR=push_inbox
# CAMERA_INBOX_DIR=./security_alert_system/state/snapshots
# CAMERA_SNAPSHOT_MAX_AGE=120

# Stream definitions — inline JSON, or use cameras.json instead.
# CAMERAS=[{"id":"gate","name":"שער כניסה","rtsp_url":"rtsp://user:pass@192.168.1.50:554/stream1","tags":["outdoor"]}]
