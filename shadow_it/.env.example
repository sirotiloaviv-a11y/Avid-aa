# --- HTTP ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Must exactly match the redirect URI registered in the Google Cloud console,
# minus the path. Google rejects the callback on any mismatch, including http
# vs https and a trailing slash.
PUBLIC_BASE_URL=https://shadowit.example.com
LOG_LEVEL=INFO
# Comma-separated origins for a browser dashboard. Leave empty for API-only.
CORS_ORIGINS=

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://shadowit:change-me@localhost:5432/shadowit
DB_POOL_MIN=1
DB_POOL_MAX=10
RUN_MIGRATIONS_ON_START=true

# --- Secrets ------------------------------------------------------------
# Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Losing this key means every stored tenant credential is unreadable and each
# customer must reconnect. Back it up somewhere that is not this database.
ENCRYPTION_KEY=
# Previous keys, comma-separated, so a rotation can still read old rows.
ENCRYPTION_KEYS=

# Platform operator key. Generate:
#   python -c "import secrets;print('sk_'+secrets.token_urlsafe(32))"
API_KEY=

# --- Providers ----------------------------------------------------------
# Configure at least one. Each is independent: a Google-only or a
# Microsoft-only deployment is a supported shape.

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI:
#   ${PUBLIC_BASE_URL}/v1/connect/google/callback
# Enable the Admin SDK API on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Entra ID (Azure portal) -> App registrations -> New registration
#   - Supported account types: "Accounts in any organizational directory"
#     (multi-tenant) — customers admin-consent to this one registration.
#   - Redirect URI (type Web):
#       ${PUBLIC_BASE_URL}/v1/connect/microsoft/callback
#   - API permissions, type *Application* (not delegated):
#       Application.Read.All, Directory.Read.All
#     Optional, only if you want in-app revocation:
#       DelegatedPermissionGrant.ReadWrite.All, AppRoleAssignment.ReadWrite.All
#   - Certificates & secrets -> New client secret. Note the expiry: when it
#     lapses, every customer scan fails at once with an auth error.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Scanning -----------------------------------------------------------
# Google: tokens.list is one call per user, so this is the main dial on scan
# duration. 8 is comfortably inside the default Admin SDK quota; raise only if
# you have requested more. Microsoft reads directory-wide collections instead,
# so it only bounds the per-app appRoleAssignments calls.
SCAN_CONCURRENCY=8
# 0 = scan everyone. Set a small number for a trial or a smoke test.
SCAN_MAX_USERS=0
SCAN_INTERVAL_HOURS=24
