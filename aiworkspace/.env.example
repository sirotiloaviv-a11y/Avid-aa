# Copy to aiworkspace/.env (git-ignored) and fill in. Real environment
# variables override this file. Never commit a real key.

# Leave empty to run in demo mode (clearly labelled simulated replies).
ANTHROPIC_API_KEY=

# auto (anthropic if a key is set, else demo) | anthropic | demo
AIWS_PROVIDER=auto

# Any Messages API model ID your key can use.
AIWS_MODEL=claude-opus-5

# Opt-in beta: "default" sends fallbacks + anthropic-beta:
# server-side-fallback-2026-07-01. "off" sends a plain Messages request.
AIWS_ANTHROPIC_FALLBACKS=off

# Automatic retries per message (0-3), only when the API rejected the request
# (429/5xx/529) or the connection never opened. Never after output started.
AIWS_MAX_RETRIES=2

# Loopback only; anything else is refused at startup.
AIWS_HOST=127.0.0.1
AIWS_PORT=8765

# Defaults to aiworkspace/.data/workspace.sqlite3
# AIWS_DB_PATH=

# Limits
AIWS_MAX_MESSAGE_CHARS=16000
# Ceiling per reply, including thinking tokens (billed as output). See README
# "Output cap and cost" before changing.
AIWS_MAX_OUTPUT_TOKENS=16000
AIWS_MAX_CONTEXT_CHARS=200000
AIWS_REQUEST_TIMEOUT_S=120
AIWS_RATE_LIMIT_PER_MINUTE=20
