# הגדרות נתוני שוק — קובץ דוגמה ללא סודות.
# 1. העתיקו את הקובץ הזה לקובץ בשם .env באותה תיקייה (market_info).
# 2. הדביקו את המפתחות בקובץ .env בלבד. הקובץ .env אינו נשמר ב-Git ואינו נשלח לדפדפן.
# 3. הפעילו מחדש את השרת (npm start).

# מניות — Alpha Vantage. מפתח חינמי: https://www.alphavantage.co/support/#api-key
# במסלול החינמי: נתוני סוף יום ומכסה קטנה של בקשות ביום.
ALPHA_VANTAGE_API_KEY=

# קריפטו — CoinGecko, מסלול Demo. מפתח חינמי דרך חשבון מפתח באתר CoinGecko.
# הנתונים מושהים בכמה דקות. תנאי השימוש מחייבים להציג "Powered by CoinGecko" (המערכת מציגה זאת).
COINGECKO_DEMO_API_KEY=

# אילו נכסים להציג. מניות: SYMBOL=שם לתצוגה. קריפטו: TICKER=coingecko-id
MARKET_STOCK_SYMBOLS=AAPL=Apple,MSFT=Microsoft,NVDA=NVIDIA,SPY=SPDR S&P 500 ETF
MARKET_CRYPTO_ASSETS=BTC=bitcoin,ETH=ethereum,SOL=solana

# מכסות בקשות שהמערכת לא תחרוג מהן. השאירו נמוך או שווה למכסה של המסלול שלכם.
ALPHA_VANTAGE_DAILY_LIMIT=25
ALPHA_VANTAGE_PER_MINUTE=5
COINGECKO_PER_MINUTE=30
COINGECKO_MONTHLY_LIMIT=10000

# משך שמירה במטמון לפני פנייה חוזרת לספק.
STOCK_CACHE_MINUTES=360
CRYPTO_QUOTE_CACHE_SECONDS=120
CRYPTO_HISTORY_CACHE_MINUTES=60
REQUEST_TIMEOUT_SECONDS=10
