# Copy to trading_bot/.env and fill in. Real environment variables override this file.

# paper | live
ENVIRONMENT=paper

# --- Accounts: <id>:<initial_balance>, comma-separated -----------------------
ACCOUNTS=ftmo_crypto_1:100000,apex_nq_1:50000

# --- API keys (never commit the filled-in .env) ------------------------------
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
FUTURES_API_KEY=
FUTURES_API_SECRET=

# --- Risk limits (percent) ---------------------------------------------------
# Halt for the rest of the trading day when equity falls this far.
DAILY_LOSS_LIMIT_PCT=1.5
# initial = % of the starting account size; day_start = % of today's start.
DAILY_LOSS_BASIS=initial
MAX_DRAWDOWN_PCT=5.0
# static | trailing_intraday | trailing_eod
MAX_DRAWDOWN_MODE=trailing_intraday
# Stop trailing once the drawdown floor reaches the initial balance.
DRAWDOWN_LOCK_AT_INITIAL=true
RISK_PER_TRADE_PCT=0.5
MAX_TRADES_PER_DAY=5
# Never size a trade to use more than this share of the room left to a floor.
ROOM_USAGE_FRACTION=0.8
# Deny entries if no account snapshot arrived in this many seconds.
EQUITY_STALE_SECONDS=120
# Telegram warning when the day's loss uses this % of the daily limit (100% = halt).
DAILY_LOSS_WARN_LEVELS=50,80

# --- Trading day (when daily limits reset) -----------------------------------
# CME / most futures props: 17:00 America/New_York. Many crypto props: 00:00 UTC.
DAILY_RESET_TZ=America/New_York
DAILY_RESET_TIME=17:00

# --- Economic news safeguard -------------------------------------------------
# forexfactory | file | none
NEWS_CALENDAR_SOURCE=forexfactory
# Optional hand-maintained events (same JSON shape); merged with the feed.
NEWS_CALENDAR_FILE=
NEWS_BLACKOUT_MINUTES_BEFORE=15
NEWS_BLACKOUT_MINUTES_AFTER=15
NEWS_CURRENCIES=USD
NEWS_CALENDAR_REFRESH_MINUTES=360
# Block entries when no fresh calendar data is available.
NEWS_FAIL_CLOSED=true
NEWS_MAX_DATA_AGE_HOURS=24

# --- Telegram alerts & commands ---------------------------------------------
# Token from @BotFather. Chat IDs: message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy message.chat.id.
# Alerts go to every chat listed; commands are accepted ONLY from these chats.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_COMMANDS_ENABLED=true
# End-of-day summary, sent this many minutes before the daily reset.
TELEGRAM_DAILY_SUMMARY=true
TELEGRAM_SUMMARY_LEAD_MINUTES=1

# --- Web dashboard -----------------------------------------------------------
# Enabled when DASHBOARD_PASSWORD is set (12+ characters). HTTP Basic auth.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# 127.0.0.1 = reachable only through an HTTPS reverse proxy or SSH tunnel
# (recommended). 0.0.0.0 exposes it directly, with the password in clear text
# over plain HTTP.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Account badge shows HIGH_RISK at this % of the daily or max drawdown limit.
DASHBOARD_HIGH_RISK_PCT=80

# --- Trading (Module 4) --------------------------------------------------------
# Off by default: `run` only monitors until you set this to true.
TRADING_ENABLED=false
STRATEGY=ema_cross
# NQ / MNQ (futures), BTCUSDT / ETHUSDT (crypto). On small accounts prefer MNQ:
# one NQ contract with an ATR stop often risks more than 0.5% of $50k.
STRATEGY_SYMBOLS=MNQ,BTCUSDT
STRATEGY_TIMEFRAME_MINUTES=5
EMA_FAST=9
EMA_SLOW=21
ATR_PERIOD=14
ATR_STOP_MULT=1.5
REWARD_RISK=2.0
ALLOW_SHORT=true
# Close every position when a high-impact news blackout starts.
FLATTEN_ON_NEWS=true
# How often balances/positions are pulled from the brokers.
ACCOUNT_POLL_SECONDS=5

# Which broker trades each account: <account>=paper[:futures|crypto],
# <account>=tradovate:<Tradovate account name>, <account>=bybit.
# Accounts not listed trade on the paper broker.
ACCOUNT_ROUTES=apex_nq_1=paper:futures,ftmo_crypto_1=paper:crypto

# auto = Bybit public klines for crypto, Tradovate charts for futures
# (simulated futures bars in paper mode without Tradovate);
# simulated = random walk; replay = MARKET_DATA_REPLAY_FILE (CSV).
MARKET_DATA=auto
MARKET_DATA_REPLAY_FILE=
# Seconds between simulated bars (default: the timeframe).
SIMULATED_BAR_SECONDS=

# Tradovate (demo endpoint unless ENVIRONMENT=live). CID/secret come from
# Tradovate's API access page (FUTURES_API_KEY/SECRET are used if unset).
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=trading-bot
TRADOVATE_CID=
TRADOVATE_SECRET=
# Front-month contracts; roll before expiry.
TRADOVATE_CONTRACTS=NQ:NQZ6,MNQ:MNQZ6

# Bybit (testnet unless ENVIRONMENT=live). One key per account:
# BYBIT_API_KEY_<ACCOUNT_ID> / BYBIT_API_SECRET_<ACCOUNT_ID>, falling back to
# CRYPTO_API_KEY / CRYPTO_API_SECRET.
# BYBIT_API_KEY_FTMO_CRYPTO_1=
# BYBIT_API_SECRET_FTMO_CRYPTO_1=

# --- Logging & state ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
STATE_DB_PATH=state/bot_state.db
