# Copy to .env and fill in. Never commit the real .env.
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
TRADINGVIEW_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public HTTPS URL ending in /telegram/webhook; secret: 1-256 chars of A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# paper = simulated orders only; live = real orders on the exchange
ENVIRONMENT=paper
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
