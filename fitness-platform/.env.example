# Copy to .env and export before running. Nothing here has a production-safe
# default: the app refuses to start in production without SECRET_KEY, and it
# refuses to run there with the mock payment provider.

# --- branding (41) ---------------------------------------------------------
BRAND_NAME=FitLife
BRAND_TAGLINE=כושר שנבנה בשבילך
SUPPORT_EMAIL=hello@example.com

# --- environment -----------------------------------------------------------
APP_ENV=development          # development | production
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# --- database --------------------------------------------------------------
DATABASE_PATH=./var/app.db

# --- security (34) ---------------------------------------------------------
SECRET_KEY=                  # REQUIRED in production; generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECURE_COOKIES=false         # true once the app is behind HTTPS
SESSION_TTL_SECONDS=1209600
PASSWORD_ITERATIONS=240000
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=12

# --- AI provider (44, 50) --------------------------------------------------
AI_PROVIDER=mock             # mock | anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_DAILY_MESSAGE_LIMIT=60

# --- payments (45, 50) -----------------------------------------------------
PAYMENT_PROVIDER=mock        # mock only until a gateway is implemented
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=change-me

# --- storage (50) ----------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_ROOT=./var/uploads
STORAGE_PUBLIC_PREFIX=/uploads
