# Copy to crypto_alerts/.env and fill in. Real environment variables win over
# this file. Never commit .env — it is already in .gitignore.

# --- Telegram ------------------------------------------------------------
# Create a bot with @BotFather. For the chat ID, message your bot once, then
# open https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = print alerts to the console instead of sending (no Telegram needed)
DRY_RUN=false
SEND_STARTUP_MESSAGE=true
# Optional second chat/channel that receives only URGENT alerts. Bots cannot
# pick a sound per message, so set a custom notification sound for this chat
# in the Telegram app (chat → Notifications → Sound) to get a distinct alarm.
TELEGRAM_URGENT_CHAT_ID=
# true = normal alerts arrive silently; only urgent ones make a sound
TELEGRAM_QUIET_NORMAL_ALERTS=false

# --- Exchange ------------------------------------------------------------
# Any ccxt exchange id: binance, bybit, okx, kraken, ...
EXCHANGE_ID=binance
# spot | swap (perpetuals). Perp symbols: BTC/USDT:USDT
MARKET_TYPE=spot
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=15m
USE_WEBSOCKET=true
# Only used when websockets are off or unsupported
POLL_INTERVAL_SECONDS=15
# Reconnect if the websocket is silent this long
STREAM_TIMEOUT_SECONDS=120
HISTORY_CANDLES=300
# Optional — market data is public. If you set keys, make them READ-ONLY:
# this system never places orders and never needs trade permission.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=false

# --- Risk & position sizing -----------------------------------------------
ACCOUNT_EQUITY=1000000
# Percent of equity lost if the stop is hit: 0.5 means 0.5% ($5,000 on $1M)
RISK_PER_TRADE_PCT=0.5
RISK_REWARD_RATIO=2.5
# atr | swing | hybrid (swing stop, kept between MIN_STOP_ATR and MAX_STOP_ATR)
STOP_MODE=hybrid
ATR_STOP_MULTIPLIER=1.5
SWING_BUFFER_ATR=0.2
MIN_STOP_ATR=0.5
MAX_STOP_ATR=3.0
# Notional cap = equity x MAX_LEVERAGE. Tight stops can otherwise imply huge size.
MAX_LEVERAGE=3
# Taker fee per side in percent (Binance spot 0.1, Bybit perp 0.055). When set,
# the size is reduced so price loss + both fees equals the risk budget.
FEE_RATE_PCT=0
ENTRY_ZONE_ATR=0.15

# --- Liquidity guard (order book slippage check at alert time) ------------
LIQUIDITY_CHECK=true
# warn   = send with a THIN BOOK warning
# reduce = shrink the size to what the book absorbs within MAX_SLIPPAGE_PCT
# filter = drop the alert
LIQUIDITY_ACTION=warn
# Expected average fill vs mid price, in percent (0.1 = 0.1%)
MAX_SLIPPAGE_PCT=0.1
# Levels per side to fetch. Binance futures accepts 5/10/20/50/100/500/1000.
ORDER_BOOK_DEPTH=100

# --- Urgent / high-conviction alerts ----------------------------------------
# An alert is urgent when it has >= URGENT_MIN_FACTORS conviction factors
# (extreme RSI, extreme volume, with the trend) and the liquidity check passed.
URGENT_ALERTS=true
URGENT_MIN_FACTORS=2
EXTREME_RSI_MARGIN=10
EXTREME_VOLUME_FACTOR=2
# Pushover (https://pushover.net): create an application for the token; the
# user key is on your dashboard. Leave empty to disable.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# -2..2. 1 = high (bypasses quiet hours). 2 = emergency: repeats every 60s
# for 30 min until you acknowledge it in the app.
PUSHOVER_PRIORITY=1
# pushover, bike, bugle, cashregister, classical, cosmic, falling, gamelan,
# incoming, intermission, magic, mechanical, pianobar, siren, spacealarm,
# tugboat, alien, climb, persistent, echo, updown, none — or a custom sound you uploaded
PUSHOVER_SOUND=cashregister
PUSHOVER_URGENT_ONLY=true
# Sound on the machine running the bot (run without a shell). Examples:
#   macOS: afplay /System/Library/Sounds/Glass.aiff
#   Linux: paplay /usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga
SOUND_COMMAND=
SOUND_URGENT_ONLY=true

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_ENABLED=true
# Keep 127.0.0.1 and use an SSH tunnel to view it remotely. Any other host
# REQUIRES a token (open http://host:port/?token=... once to log in).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# --- Strategy ------------------------------------------------------------
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
# 1 = the signal candle itself must be oversold/overbought
RSI_LOOKBACK=1
VOLUME_MA_PERIOD=20
VOLUME_SPIKE_MULTIPLIER=2.5
ATR_PERIOD=14
FAST_MA_PERIOD=50
SLOW_MA_PERIOD=200
SWING_WIDTH=3
SR_LOOKBACK=100
SR_TOLERANCE_ATR=0.5
# true = longs only above the slow EMA, shorts only below it
TREND_FILTER=false

# --- Runtime -------------------------------------------------------------
ALERT_COOLDOWN_MINUTES=60
LOG_LEVEL=INFO
