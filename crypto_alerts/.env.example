# Copy to crypto_alerts/.env and fill in. Real environment variables win over
# this file. Never commit .env — it is already in .gitignore.

# --- Telegram ------------------------------------------------------------
# Create a bot with @BotFather. For the chat ID, message your bot once, then
# open https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = print alerts to the console instead of sending (no Telegram needed)
DRY_RUN=false
SEND_STARTUP_MESSAGE=true

# --- Exchange ------------------------------------------------------------
# Any ccxt exchange id: binance, bybit, okx, kraken, ...
EXCHANGE_ID=binance
# spot | swap (perpetuals). Perp symbols: BTC/USDT:USDT
MARKET_TYPE=spot
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=15m
USE_WEBSOCKET=true
# Only used when websockets are off or unsupported
POLL_INTERVAL_SECONDS=15
# Reconnect if the websocket is silent this long
STREAM_TIMEOUT_SECONDS=120
HISTORY_CANDLES=300
# Optional — market data is public. If you set keys, make them READ-ONLY:
# this system never places orders and never needs trade permission.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=false

# --- Risk & position sizing -----------------------------------------------
ACCOUNT_EQUITY=1000000
# Percent of equity lost if the stop is hit: 0.5 means 0.5% ($5,000 on $1M)
RISK_PER_TRADE_PCT=0.5
RISK_REWARD_RATIO=2.5
# atr | swing | hybrid (swing stop, kept between MIN_STOP_ATR and MAX_STOP_ATR)
STOP_MODE=hybrid
ATR_STOP_MULTIPLIER=1.5
SWING_BUFFER_ATR=0.2
MIN_STOP_ATR=0.5
MAX_STOP_ATR=3.0
# Notional cap = equity x MAX_LEVERAGE. Tight stops can otherwise imply huge size.
MAX_LEVERAGE=3
# Taker fee per side in percent (Binance spot 0.1, Bybit perp 0.055). When set,
# the size is reduced so price loss + both fees equals the risk budget.
FEE_RATE_PCT=0
ENTRY_ZONE_ATR=0.15

# --- Strategy ------------------------------------------------------------
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
# 1 = the signal candle itself must be oversold/overbought
RSI_LOOKBACK=1
VOLUME_MA_PERIOD=20
VOLUME_SPIKE_MULTIPLIER=2.5
ATR_PERIOD=14
FAST_MA_PERIOD=50
SLOW_MA_PERIOD=200
SWING_WIDTH=3
SR_LOOKBACK=100
SR_TOLERANCE_ATR=0.5
# true = longs only above the slow EMA, shorts only below it
TREND_FILTER=false

# --- Runtime -------------------------------------------------------------
ALERT_COOLDOWN_MINUTES=60
LOG_LEVEL=INFO
