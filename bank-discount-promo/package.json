{
  "name": "bank-discount-promo",
  "version": "1.0.0",
  "private": true,
  "description": "20-second vertical (1080x1920 @ 30fps) promo video for Bank Discount, built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts DiscountPromo out/discount-promo.mp4 --codec=h264 --crf=18",
    "still": "remotion still src/index.ts DiscountPromo out/poster.png --frame=560",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.250",
    "@remotion/google-fonts": "^4.0.250",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.250"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
