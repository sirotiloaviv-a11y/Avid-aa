{%- comment -%} סנאנס — באנר דילים יומי עם שעון ספירה לאחור ושורת מוצרים במבצע {%- endcomment -%}
<section class="sn-section sn-container" id="sn-deals-{{ section.id }}">
  <div class="sn-deals">
    <div>
      {%- if section.settings.tag != blank -%}
        <span class="sn-deals__tag">{{ section.settings.tag }}</span>
      {%- endif -%}
      <h2 class="sn-deals__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="sn-deals__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="sn-deals__side">
      {%- if section.settings.show_countdown -%}
        <div class="sn-countdown" data-sn-countdown role="timer" aria-label="הזמן שנותר למבצע">
          <div class="sn-countdown__unit"><span class="sn-countdown__num" data-h>00</span><span class="sn-countdown__lbl">שעות</span></div>
          <div class="sn-countdown__unit"><span class="sn-countdown__num" data-m>00</span><span class="sn-countdown__lbl">דקות</span></div>
          <div class="sn-countdown__unit"><span class="sn-countdown__num" data-s>00</span><span class="sn-countdown__lbl">שניות</span></div>
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: section.settings.collection.url | default: routes.all_products_collection_url }}" class="sn-btn sn-deals__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.collection != blank -%}
    <ul class="sn-grid sn-grid--scroll sn-deals-row">
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <li>{% render 'sanans-product-card', product: product %}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{%- if section.settings.show_countdown -%}
  <script>
    (() => {
      const root = document.querySelector('#sn-deals-{{ section.id }} [data-sn-countdown]');
      if (!root) return;
      const pad = (n) => String(n).padStart(2, '0');
      const tick = () => {
        const now = new Date();
        const end = new Date(now);
        end.setHours(24, 0, 0, 0); // המבצע מתחדש כל חצות
        const left = Math.max(0, Math.floor((end - now) / 1000));
        root.querySelector('[data-h]').textContent = pad(Math.floor(left / 3600));
        root.querySelector('[data-m]').textContent = pad(Math.floor((left % 3600) / 60));
        root.querySelector('[data-s]').textContent = pad(left % 60);
      };
      tick();
      setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "סנאנס — דיל יומי",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "tag", "label": "תגית", "default": "🔥 דיל היום" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מחירים שלא חוזרים — רק עד חצות" },
    { "type": "textarea", "id": "text", "label": "טקסט", "default": "כל יום מבחר מוצרי יסוד במחיר מיוחד. כשהשעון מתאפס — הדיל נגמר." },
    { "type": "checkbox", "id": "show_countdown", "label": "שעון ספירה לאחור עד חצות", "default": true },
    { "type": "text", "id": "button_label", "label": "טקסט כפתור", "default": "לכל הדילים" },
    { "type": "url", "id": "button_link", "label": "קישור כפתור" },
    { "type": "collection", "id": "collection", "label": "קולקציית מבצעים (מוצגת מתחת לבאנר)" },
    { "type": "range", "id": "products_to_show", "label": "מספר מוצרים", "min": 2, "max": 15, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "סנאנס — דיל יומי" }]
}
{% endschema %}
