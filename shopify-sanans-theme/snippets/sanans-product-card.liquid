{%- comment -%}
  כרטיס מוצר לסופרמרקט, עם הוספה מהירה לעגלה.
  שימוש: {% render 'sanans-product-card', product: product %}
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign image_alt = product.featured_media.alt | default: product.title | escape
-%}
<article class="sn-card{% unless product.available %} sn-card--soldout{% endunless %}">
  <div class="sn-card__media">
    {%- render 'sanans-sale-badge', product: product -%}
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          widths: '200, 300, 400, 600',
          sizes: '(min-width: 990px) 240px, (min-width: 750px) 30vw, 45vw',
          class: 'sn-card__img',
          alt: image_alt
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'sn-card__img' }}
    {%- endif -%}
  </div>

  <div class="sn-card__body">
    {%- if product.vendor != blank -%}
      <span class="sn-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <h3 class="sn-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="sn-card__price">
      <span class="sn-price{% if on_sale %} sn-price--sale{% endif %}">
        {%- if product.price_varies -%}החל מ-{%- endif -%}
        {{ product.price | money }}
      </span>
      {%- if on_sale -%}
        <s class="sn-price__compare">
          <span class="visually-hidden">מחיר רגיל</span>
          {{ product.compare_at_price | money }}
        </s>
      {%- endif -%}
    </div>
    {%- if variant.unit_price_measurement -%}
      <span class="sn-card__unit">
        {{ variant.unit_price | money }} ל-
        {%- if variant.unit_price_measurement.reference_value != 1 -%}
          {{ variant.unit_price_measurement.reference_value }}
        {%- endif %}
        {{ variant.unit_price_measurement.reference_unit }}
      </span>
    {%- endif -%}

    <div class="sn-card__footer">
      {%- if product.available and product.has_only_default_variant -%}
        <form method="post" action="{{ routes.cart_add_url }}" class="sn-quick-add" data-sn-quick-add>
          <input type="hidden" name="id" value="{{ variant.id }}">
          <div class="sn-qty">
            <button type="button" data-sn-qty="1" aria-label="הוספת כמות">+</button>
            <input
              type="number"
              name="quantity"
              value="1"
              min="1"
              max="99"
              inputmode="numeric"
              aria-label="כמות עבור {{ product.title | escape }}"
            >
            <button type="button" data-sn-qty="-1" aria-label="הפחתת כמות">−</button>
          </div>
          <button type="submit" class="sn-btn-add" aria-label="הוספת {{ product.title | escape }} לעגלה">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20.5" r="1.3"/><circle cx="17" cy="20.5" r="1.3"/></svg>
            <span data-label>הוספה</span>
          </button>
        </form>
      {%- elsif product.available -%}
        <a href="{{ product.url }}" class="sn-btn-add sn-btn-add--ghost">
          <span data-label>בחירת גודל / סוג</span>
        </a>
      {%- else -%}
        <button type="button" class="sn-btn-add" disabled>
          <span data-label>אזל זמנית</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</article>
